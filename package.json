{
  "name": "@ilamanownuk/blog-kit",
  "version": "0.2.2",
  "description": "Reusable Tiptap blog editor for Next.js: Aparat/YouTube embeds, image upload, media library picker, server-side sanitizer and renderer.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "author": "ilamanownuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilamanownuk/blog-kit.git"
  },
  "homepage": "https://github.com/ilamanownuk/blog-kit#readme",
  "bugs": {
    "url": "https://github.com/ilamanownuk/blog-kit/issues"
  },
  "keywords": [
    "tiptap",
    "rich-text-editor",
    "blog",
    "nextjs",
    "rtl",
    "persian",
    "aparat",
    "sanitize-html"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AI_INSTALL_PROMPT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layered.css": "./dist/styles.layered.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lucide-react": "1.28.0",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
